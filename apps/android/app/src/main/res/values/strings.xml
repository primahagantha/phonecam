    <string name="permission_action_settings">Open settings</string>
    <string name="notification_permission_warning">Notifications are off, so the streaming status won\'t appear in your notification shade. Streaming still works.</string>
    <string name="usb_hint_title">USB debugging</string>
    <string name="usb_hint_body">A cable connection needs USB debugging turned on in Developer options on this phone. Settings → About phone → tap the OS version 7 times, then Settings → Additional settings → Developer options → USB debugging.</string>
