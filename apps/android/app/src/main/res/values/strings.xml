<?xml version="1.0" encoding="utf-8"?>
<!--
    Every string this app shows to a person lives here (PRD §38).

    Prose that the session layer already produced (SessionState.notice,
    SessionState.error, DialResult messages) is rendered verbatim: it is part of
    the session contract, not of this screen's copy.
-->
