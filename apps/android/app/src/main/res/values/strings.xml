    <string name="diagnostics_encoder_software">Software</string>
    <!--
      Shown for a value the phone has not measured yet: the encoder probe (a
      MediaCodecList query) and the camera probe both run off the main thread, so
      for a moment after launch nothing has looked. "Software" or "Cameras found:
      0" would assert an answer the phone has not earned.
    -->
    <string name="diagnostics_not_detected">Not detected yet</string>
