<?xml version="1.0" encoding="utf-8"?>
<!--
    The palette. One source of truth: the Compose theme, the XML window theme and
    the launcher icon all read these, so nothing can drift.

    Two rules hold this file together.

    1. ONE accent hue. `phonecam_primary` is the only accent in the app, and
       everything that means "this is live / this is in use" uses it. The light
       theme carries the same hue at a darker lightness (`_on_light`) because the
       brand green is unreadable as text on a white surface; that is a lightness
       change, never a second hue.

    2. Status colours are state, not decoration. Info, warning and error each get
       a container + on-container pair and are used only for the condition they
       name. Nothing else in the UI is allowed to borrow them.

    Every foreground/background pair used by the UI was checked against WCAG AA:
    4.5:1 for body text, 3:1 for borders, icons and indicator dots. The pairs are
    listed next to each role so a future edit can be re-checked without guessing.
-->
<resources>
    <!-- Dark: the default. A phone used as a webcam is often the only light in
         the room, so the dark scheme is the one that must be right. -->
    <color name="phonecam_background">#0B0F14</color>
    <color name="phonecam_on_background">#E6EAF0</color>

    <!-- Card surface, lifted off the background by one step plus a hairline. -->
    <color name="phonecam_surface">#171F29</color>
    <color name="phonecam_on_surface">#E6EAF0</color>

    <!-- Inset wells (log box, disabled chip): recessed, not lifted. -->
    <color name="phonecam_surface_variant">#232D3A</color>
    <color name="phonecam_on_surface_variant">#A9B4C0</color>

    <!-- Strong stroke: pill outlines and card edges. 4.27:1 on surface. -->
    <color name="phonecam_outline">#72829E</color>
    <!-- Hairline separator. Structural only, carries no meaning on its own. -->
    <color name="phonecam_outline_variant">#2A3542</color>

    <!-- The accent. -->
    <color name="phonecam_primary">#6FD08C</color>
    <color name="phonecam_on_primary">#06240F</color>
    <color name="phonecam_primary_container">#1E4630</color>
    <color name="phonecam_on_primary_container">#A8F0C0</color>

    <!-- Info: a substitution notice. Blue, deliberately not the warning amber. -->
    <color name="phonecam_info_container">#16374F</color>
    <color name="phonecam_on_info_container">#C2DDF7</color>

    <!-- Warning: thermal and battery advice. -->
    <color name="phonecam_warning">#FFD48A</color>
    <color name="phonecam_warning_container">#3A2E12</color>
    <color name="phonecam_on_warning_container">#FFE6B8</color>

    <color name="phonecam_error">#FFB4AB</color>
    <color name="phonecam_on_error">#690005</color>
    <color name="phonecam_error_container">#5C1A18</color>
    <color name="phonecam_on_error_container">#FFDAD6</color>

    <!-- Snackbars and the streaming strip: a surface that inverts the page so it
         reads as "above" the content without a shadow. -->
    <color name="phonecam_inverse_surface">#232D3A</color>
    <color name="phonecam_inverse_on_surface">#E6EAF0</color>
    <color name="phonecam_inverse_primary">#6FD08C</color>

    <!-- Light: for a phone read in daylight. Same roles, same accent hue. -->
    <color name="phonecam_light_background">#F2F5F8</color>
    <color name="phonecam_light_on_background">#10161D</color>
    <color name="phonecam_light_surface">#FFFFFF</color>
    <color name="phonecam_light_on_surface">#10161D</color>
    <color name="phonecam_light_surface_variant">#E8EDF3</color>
    <color name="phonecam_light_on_surface_variant">#4C5666</color>
    <color name="phonecam_light_outline">#6B7688</color>
    <color name="phonecam_light_outline_variant">#C3CCD8</color>

    <color name="phonecam_light_primary">#12603A</color>
    <color name="phonecam_light_on_primary">#FFFFFF</color>
    <color name="phonecam_light_primary_container">#C6EFD6</color>
    <color name="phonecam_light_on_primary_container">#07331D</color>

    <color name="phonecam_light_info_container">#C6DEF4</color>
    <color name="phonecam_light_on_info_container">#0A2136</color>

    <color name="phonecam_light_warning">#8A5A00</color>
    <color name="phonecam_light_warning_container">#FBEFC9</color>
    <color name="phonecam_light_on_warning_container">#3A2E08</color>

    <color name="phonecam_light_error">#B3261E</color>
    <color name="phonecam_light_on_error">#FFFFFF</color>
    <color name="phonecam_light_error_container">#F9DEDC</color>
    <color name="phonecam_light_on_error_container">#410E0B</color>

    <color name="phonecam_light_inverse_surface">#2E3440</color>
    <color name="phonecam_light_inverse_on_surface">#EFF1F5</color>
    <color name="phonecam_light_inverse_primary">#6FD08C</color>

    <!-- Launcher icon. Its own artwork, not part of the screen palette. -->
    <color name="ic_launcher_background">#10131A</color>
</resources>
