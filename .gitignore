# Rust build outputs
/target/
**/*.rs.bk
Cargo.lock.orig

# Android & Gradle artifacts
/apps/android/.gradle/
/apps/android/.kotlin/
/apps/android/.idea/
/apps/android/build/
/apps/android/app/build/
/apps/android/local.properties
*.hprof
*.keystore
!debug.keystore

# Generated APKs, prebuilt binaries, and install artifacts
/dist/installer/*.exe
/dist/unpacked/*.dll
/dist/unpacked/*.exe
/dist/unpacked/*.apk
/dist/PhoneCam.apk
/dist/*.zip
/dist/*.tar.gz
/*.apk
*.apk
*.aab
phone_installed.apk

# Keep Android JNI libraries built from phonecam-android-core
!apps/android/app/src/main/jniLibs/**/*.so

# Keep non-binary packaging assets and helper scripts in dist/unpacked
!dist/unpacked/icon.ico
!dist/unpacked/*.bat
!dist/unpacked/*.txt

# Local agent / promo scratch directories
.agents/
skills-lock.json
promos/
__pycache__/
*.pyc

# OS & Editor files
*.log
.DS_Store
Thumbs.db
ehthumbs.db
.vscode/
.idea/
*.swp
*.swo
